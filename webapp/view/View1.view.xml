<mvc:View controllerName="project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    <Page id="page" title="{i18n>title}">
        <content>
            <VBox id="vboxContainer" class="sapUiResponsiveMargin employeeDirectoryShell">
                <Toolbar>
                    <Title text="{i18n>directorySubtitle}" level="H3"/>
                    <ToolbarSpacer/>
                    <ObjectStatus text="{view>/resultCount} of {view>/totalCount} employees" state="Information"/>
                </Toolbar>

                <HBox wrap="Wrap" renderType="Bare" class="directorySummary">
                    <VBox class="summaryCard sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <Label text="{i18n>summaryTotalEmployees}" />
                        <ObjectNumber number="{view>/totalCount}" emphasized="false" />
                    </VBox>
                    <VBox class="summaryCard sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <Label text="{i18n>summaryActiveEmployees}" />
                        <ObjectNumber number="{view>/summary/activeCount}" state="Success" emphasized="false" />
                    </VBox>
                    <VBox class="summaryCard sapUiTinyMarginEnd sapUiTinyMarginBottom">
                        <Label text="{i18n>summaryDepartments}" />
                        <ObjectNumber number="{view>/summary/departmentCount}" emphasized="false" />
                    </VBox>
                    <VBox class="summaryCard sapUiTinyMarginBottom">
                        <Label text="{i18n>summaryLocations}" />
                        <ObjectNumber number="{view>/summary/locationCount}" emphasized="false" />
                    </VBox>
                </HBox>

                <HBox wrap="Wrap" renderType="Bare" class="sapUiSmallMarginTop sapUiSmallMarginBottom directoryFilters">
                    <SearchField
                        id="searchField"
                        width="22rem"
                        placeholder="{i18n>searchPlaceholder}"
                        liveChange="onSearch"/>
                    <Select
                        id="departmentSelect"
                        width="14rem"
                        selectedKey="{view>/selectedDepartment}"
                        change="onDepartmentChange"
                        items="{view>/departments}">
                        <items>
                            <core:Item key="{view>key}" text="{view>text}" />
                        </items>
                    </Select>
                </HBox>

                <List id="employeeList" items="{
                        path: 'employees>/EmployeeCollection',
                        sorter: {path: 'name'}
                    }"
                    noDataText="{i18n>employeeListNoData}"
                    updateFinished="onListUpdateFinished">
                    <items>
                        <ObjectListItem
                            id="employeeListItem"
                            title="{employees>name}"
                            number="{employees>id}"
                            numberState="Information"
                            type="Active"
                            press="onEmployeePress"
                            intro="{employees>department}">
                            <attributes>
                                <ObjectAttribute id="roleAttribute" title="{i18n>employeeRoleLabel}" text="{employees>role}" />
                                <ObjectAttribute id="emailAttribute" title="{i18n>employeeEmailLabel}" text="{employees>email}" />
                                <ObjectAttribute id="locationAttribute" title="{i18n>employeeLocationLabel}" text="{employees>location}" />
                                <ObjectAttribute id="managerAttribute" title="{i18n>employeeManagerLabel}" text="{employees>manager}" />
                            </attributes>
                            <firstStatus>
                                <ObjectStatus text="{employees>status}" state="{= ${employees>status} === 'Active' ? 'Success' : 'Warning' }"/>
                            </firstStatus>
                        </ObjectListItem>
                    </items>
                </List>
            </VBox>
        </content>
    </Page>
</mvc:View>
